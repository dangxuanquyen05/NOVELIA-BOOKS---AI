# ==============================================================================
# NOVELIA BOOKS — PRODUCTION & LOCALHOST ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   Windows PowerShell: Copy-Item .env.example .env
# NEVER commit your actual .env file with secrets or production passwords to Git!
# ==============================================================================

PROJECT_NAME="NOVELIA BOOKS API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL Server 8.x)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novelia_books
DB_USER=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=novelia-books-dev-super-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 3. CORS PERMISSIONS
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 4. SHIPPING ADAPTERS (GHN & GHTK)
# ------------------------------------------------------------------------------
# Options: 'mock', 'sandbox', 'live'
SHIPPING_ENVIRONMENT=sandbox
DEFAULT_SHIPPING_CARRIER=GHN

# Giao Hàng Nhanh (GHN) Sandbox
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_TOKEN=
GHN_SHOP_ID=0
GHN_CLIENT_PHONE=0987654321
GHN_WEBHOOK_SECRET=novelia-ghn-webhook-secret

# Giao Hàng Tiết Kiệm (GHTK) Sandbox
GHTK_API_URL=https://services-staging.ghtklab.com/services/shipment
GHTK_TOKEN=
GHTK_WEBHOOK_SECRET=novelia-ghtk-webhook-secret

# ------------------------------------------------------------------------------
# 5. NOVELIA AI ASSISTANT & COPILOT
# ------------------------------------------------------------------------------
# Options: 'mock', 'gemini', 'openai'
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 6. EMAIL & IN-APP NOTIFICATIONS
# ------------------------------------------------------------------------------
# Options: 'mock', 'smtp'
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@novelia.vn
SMTP_FROM_NAME=NOVELIA BOOKS
SMTP_TIMEOUT_SECONDS=5
